{
  "name": "nikki-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "vue-tsc --noEmit && vite build && node scripts/prerender.mjs && npm run verify",
    "preview": "vite preview --host 127.0.0.1 --port 4180",
    "predev": "node scripts/prepare-images.mjs",
    "prebuild": "node scripts/prepare-images.mjs",
    "verify": "node scripts/verify-image-loading.mjs && node scripts/verify-hero-timing.mjs && node scripts/verify-base-paths.mjs"
  },
  "dependencies": {
    "lucide-vue-next": "^0.577.0",
    "motion-v": "^2.4.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "sharp": "^0.35.5",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": "22.14.x"
  }
}
